# ── DATABASE (from Neon.tech) ─────────────────────
DATABASE_URL="postgresql://neondb_owner:npg_OdgUy72InwHj@ep-damp-glade-abn4817x-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── JWT SECRETS (make up your own random strings, min 32 chars each) ──
JWT_SECRET="change-this-to-any-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string-here"
